exports[`metrics > arithmetic metrics with \`fn|field\` syntax > diff > custom functions 1`] = `
[
  "select "device", cast("count"("sessions") as float)/NULLIF(cast("max"("users") as float) + 1e-10, 0)::float4 - 1  as "x" from "t" group by "device"",
]
`;


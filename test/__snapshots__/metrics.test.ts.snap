exports[`metrics > averages > aggrAverage 1`] = `
[
  "select "device", sum("aggrAverage")/max("users")::float4  as "price_aggrAverage" from (select "device", "price", sum("sessions") as "sessions", sum("users") as "users", "price" * sum("sessions") as "aggrAverage", sum("users") as "users" from "t" group by "device", "price") as "middleTable" group by "device"",
]
`;

exports[`metrics > averages > aggrAverage with to equal to by 1`] = `
[
  "select "device", sum("aggrAverage")/max("users")::float4  as "price_aggrAverage" from (select "device", "price", sum("users") as "users", sum("users") as "users", "price" * sum("users") as "aggrAverage" from "t" group by "device", "price") as "middleTable" group by "device"",
]
`;

exports[`metrics > averages > weightAvg 1`] = `
[
  "select "device", sum("weightAvg")/sum("users")::float4 as "x" from (select "device", "price", sum("users") as "users", "price" * sum("users")::float4 as "weightAvg" from "t" group by "device", "price") as "middleTable" group by "device"",
]
`;

exports[`metrics > ranking > alg denseRank 1`] = `
[
  "select "device", "t"."rank" from (select *, DENSE_RANK() OVER(ORDER BY "sessions" DESC) as "rank" from "t") as "t" group by "device", "t"."rank"",
]
`;

exports[`metrics > ranking > alg rank 1`] = `
[
  "select "device", "t"."rank" from (select *, RANK() OVER(ORDER BY "sessions" DESC) as "rank" from "t") as "t" group by "device", "t"."rank"",
]
`;

exports[`metrics > ranking > alg reverseDenseRank builds a reverse CTE 1`] = `
[
  "select "device", (max("t"."reverse_rank") over ()) - "t"."reverse_rank" + 1 as "rank" from (select *, DENSE_RANK() OVER(ORDER BY "sessions" DESC) as "reverse_rank" from "t") as "t" group by "device", "t"."reverse_rank"",
]
`;


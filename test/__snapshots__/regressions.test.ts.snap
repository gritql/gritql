exports[`SQL > doesnt merge queries with same id from different queries > should merge object correctly if id matches 1`] = `
[
  "select "date", SUM("transactionrevenue") AS "value" from "ii_transactional" where ("ii_transactional"."country" = 'US') AND (("ii_transactional"."domain" IN ('test.com','test2.com'))) AND (("ii_transactional"."date" >= '2022-01-05') AND ("ii_transactional"."date" <= '2022-01-08')) group by "date" order by "revenue" desc limit 10",
  "select "date", SUM("transactionrevenue") AS "value1" from "ii_transactionalb" where ("ii_transactionalb"."country" = 'US') AND (("ii_transactionalb"."domain" IN ('test.com','test2.com'))) AND (("ii_transactionalb"."date" >= '2022-01-05') AND ("ii_transactionalb"."date" <= '2022-01-08')) group by "date" order by "revenue" desc limit 10",
]
`;

